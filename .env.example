# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------- environment
WORKBENCH_ENV=development
WORKBENCH_LOG_LEVEL=INFO
# Freeze clocks, UUIDs and seeds so golden tests and evals are reproducible.
WORKBENCH_DETERMINISTIC=0

# ------------------------------------------------------------------- database
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench
POSTGRES_DB=workbench
POSTGRES_PORT=5433
WORKBENCH_DATABASE_URL=postgresql+asyncpg://workbench:workbench@localhost:5433/workbench

# --------------------------------------------------------------- vector store
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
WORKBENCH_QDRANT_URL=http://localhost:6333
WORKBENCH_VECTOR_BACKEND=qdrant          # qdrant | faiss

# ---------------------------------------------------------------------- queue
REDIS_PORT=6379
WORKBENCH_REDIS_URL=redis://localhost:6379/0

# -------------------------------------------------------------------- models
# LM Studio is the default backend on Apple Silicon: the MLX 4-bit builds are
# materially faster than GGUF on an M-series chip, and it speaks the OpenAI wire
# format. Start it with:  lms server start
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_ADMIN_URL=http://localhost:1234/api/v0
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1

WORKBENCH_MODEL_PROFILE=balanced         # quality | balanced | fast | demo
WORKBENCH_PROVIDER=lmstudio              # lmstudio | ollama | vllm | mock
WORKBENCH_RERANK_ENABLED=1

# Ollama tuning, used when the ollama lane is exercised on a 24GB machine.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_NUM_PARALLEL=1

# ------------------------------------------------------------------- security
# Generate with: openssl rand -hex 32
WORKBENCH_JWT_SECRET=change-me-openssl-rand-hex-32
WORKBENCH_ACCESS_TOKEN_MINUTES=15
WORKBENCH_REFRESH_TOKEN_DAYS=7
# Seed password for the demo accounts created by `make seed`.
WORKBENCH_SEED_PASSWORD=workbench123

# -------------------------------------------------------------------- sandbox
WORKBENCH_SANDBOX_BACKEND=docker         # docker | fake
WORKBENCH_SANDBOX_IMAGE=workbench/sandbox:0.1.0
WORKBENCH_SANDBOX_ALLOW_UNSAFE=0         # never set to 1 outside a throwaway box

# ------------------------------------------------------------------- frontend
NEXT_PUBLIC_APP_NAME=Sovereign AI Workbench
WORKBENCH_API_URL=http://localhost:8000
